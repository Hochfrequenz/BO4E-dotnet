{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Aufgabe": {
      "type": ["object", "null"],
      "properties": {
        "aufgabenId": {
          "type": ["string", "null"]
        },
        "beschreibung": {
          "type": ["string", "null"]
        },
        "deadline": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ausgefuehrt": {
          "type": "boolean"
        },
        "ausfuehrungszeitpunkt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ausfuehrender": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "guid": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "aufgabenId",
        "beschreibung",
        "deadline",
        "ausgefuehrt",
        "ausfuehrungszeitpunkt",
        "ausfuehrender"
      ]
    },
    "ExterneReferenz": {
      "type": ["object", "null"],
      "properties": {
        "exRefName": {
          "type": ["string", "null"]
        },
        "exRefWert": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "guid": {
          "type": ["string", "null"]
        }
      },
      "required": ["exRefName", "exRefWert"]
    },
    "GenericStringStringInfo": {
      "type": ["object", "null"],
      "properties": {
        "keyColumn": {
          "type": ["string", "null"]
        },
        "value": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "guid": {
          "type": ["string", "null"]
        }
      },
      "required": ["keyColumn", "value"]
    },
    "Notiz": {
      "type": ["object", "null"],
      "properties": {
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "guid": {
          "type": ["string", "null"]
        },
        "inhalt": {
          "type": ["string", "null"]
        },
        "autor": {
          "type": ["string", "null"]
        },
        "zeitpunkt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["inhalt", "autor", "zeitpunkt"]
    },
    "Zeitraum": {
      "type": ["object", "null"],
      "properties": {
        "einheit": {
          "type": ["string", "null"],
          "enum": [
            null,
            "SEKUNDE",
            "MINUTE",
            "STUNDE",
            "VIERTEL_STUNDE",
            "TAG",
            "WOCHE",
            "MONAT",
            "QUARTAL",
            "HALBJAHR",
            "JAHR"
          ]
        },
        "dauer": {
          "type": ["number", "null"]
        },
        "startdatum": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "enddatum": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "startzeitpunkt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "endzeitpunkt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "guid": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "einheit",
        "dauer",
        "startdatum",
        "enddatum",
        "startzeitpunkt",
        "endzeitpunkt"
      ]
    }
  },
  "type": "object",
  "properties": {
    "boTyp": {
      "type": ["string", "null"]
    },
    "versionStruktur": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "benachrichtigungsId": {
      "type": ["string", "null"]
    },
    "externeReferenzen": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/ExterneReferenz"
      }
    },
    "prioritaet": {
      "type": "string",
      "default": "NORMAL",
      "enum": ["SEHR_NIEDRIG", "NIEDRIG", "NORMAL", "HOCH", "SEHR_HOCH"]
    },
    "guid": {
      "type": ["string", "null"]
    },
    "bearbeitungsstatus": {
      "type": "string",
      "default": "OFFEN",
      "enum": [
        "OFFEN",
        "IN_BEARBEITUNG",
        "ABGESCHLOSSEN",
        "STORNIERT",
        "QUITTIERT",
        "IGNORIERT"
      ]
    },
    "kurztext": {
      "type": ["string", "null"]
    },
    "erstellungsZeitpunkt": {
      "type": "string",
      "format": "date-time"
    },
    "kategorie": {
      "type": ["string", "null"]
    },
    "bearbeiter": {
      "type": ["string", "null"]
    },
    "notizen": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/Notiz"
      }
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "aufgaben": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/Aufgabe"
      }
    },
    "infos": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/GenericStringStringInfo"
      }
    },
    "gueltigkeitszeitraum": {
      "$ref": "#/definitions/Zeitraum"
    },
    "qualitaet": {
      "type": ["string", "null"],
      "enum": [
        null,
        "VOLLSTAENDIG",
        "INFORMATIV",
        "IM_SYSTEM_VORHANDEN",
        "ERWARTET",
        "VORLAEUFIG",
        "UNVOLLSTAENDIG"
      ]
    }
  },
  "required": [
    "boTyp",
    "versionStruktur",
    "benachrichtigungsId",
    "externeReferenzen",
    "prioritaet",
    "bearbeitungsstatus",
    "kurztext",
    "erstellungsZeitpunkt",
    "kategorie",
    "bearbeiter",
    "notizen",
    "deadline",
    "aufgaben",
    "infos"
  ]
}

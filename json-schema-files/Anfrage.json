    "versionStruktur",
    "externeReferenzen",
    "lokationsId",
    "lokationsTyp",
    "obiskennzahl",
    "ZeitraumMesswertanfrage",
    "anfragekategorie",
    "anfragetyp",
    "positionsnummer"
  ]

      "required": [
        "einheit",
        "dauer",
        "startdatum",
        "enddatum",
        "startzeitpunkt",
        "endzeitpunkt"
      ]
    }
  },
  "type": "object",
  "properties": {
    "boTyp": {
      "type": ["string", "null"]

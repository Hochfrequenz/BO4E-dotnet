{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Produktpaket",
  "definitions": {
    "Produktkonfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/COM"
        },
        {
          "type": "object",
          "description": "Einzelne Produktkonfiguration in einem Produktpaket.",
          "additionalProperties": {},
          "properties": {
            "code": {
              "description": "Eindeutiger Code der Konfiguration",
              "x-nullable": true,
              "oneOf": [
                {
                  "$ref": "#/definitions/Produktcode"
                }
              ]
            },
            "eigenschaft": {
              "description": "Eigenschaftswert zur Konfiguration (als Code)",
              "x-nullable": true,
              "oneOf": [
                {
                  "$ref": "#/definitions/Produktcode"
                }
              ]
            },
            "zusatzeigenschaft": {
              "type": "string",
              "description": "Zusätzlicher Eigenschaftswert, z.B. Angabe der Jahresverbrauchsprognose (4000).\n            Im Allgemeinen zur Angabe von Werten, die nicht als Produktcode definiert sind",
              "x-nullable": true
            }
          }
        }
      ]
    },
    "Produktcode": {

        "NETZENTGELTE_NETZORIENTIERTE_STEUERUNG",
        "PAUSCHALE_REDUZIERUNG_MODUL_1",
        "PROZENTUALE_REDUZIERUNG_AP_MODUL_2",
        "ANREIZMODUL_3",
        "NETZENTGELTE_PREISSYSTEM",
        "JAHRESLEISTUNG",

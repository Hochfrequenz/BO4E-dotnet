          "x-nullable": true,
          "items": {
            "$ref": "#/definitions/Lastprofil"
          }
        },
        "bilanzierungsbeginn": {
          "type": "string",
          "description": "Inklusiver Start der Bilanzierung",
          "format": "date-time",
          "x-nullable": true
        },
        "bilanzierungsende": {
          "type": "string",
          "description": "Exklusives Ende der Bilanzierung",
          "format": "date-time",
          "x-nullable": true
        },
        "bilanzkreis": {
          "type": "string",
          "description": "Bilanzkreis, should obey IsValidEIC",
          "x-nullable": true
        },
        "jahresverbrauchsprognose": {
          "description": "Jahresverbrauchsprognose",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Menge"
            }
          ]
        },
        "temperaturarbeit": {
          "description": "Kundenwert",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Menge"
            }
          ]
        },
        "kundenwert": {
          "description": "Kundenwert",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Menge"
            }
          ]
        },
        "verbrauchsaufteilung": {
          "type": "number",
          "description": "Verbrauchsaufteilung in % zwischen SLP und TLP-Profil\n1. [Gemessene Energiemenge der OBIS \"nicht Schwachlast\"] * [Verbrauchsaufteilung in % / 100%] = [zu verlagernde Energiemenge]\n2. [Gemessene Energiemenge der OBIS \"Schwachlast\"] - [zu verlagernde Energiemenge] = [Ermittelte Energiemenge für\n   Schwachlast]\n3. [Gemessene Energiemenge der OBIS \"nicht Schwachlast\"] + [zu verlagernde Energiemenge] = [Ermittelte Energiemenge für nicht\n   Schwachlast]\n            ",
          "format": "double",
          "x-nullable": true
        },
        "zeitreihentyp": {
          "description": "Zeitreihentyp (SLS, TLS, etc.)\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Zeitreihentyp"
            }
          ]
        },
        "aggregationsverantwortung": {
          "description": "Aggregationsverantwortung\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Aggregationsverantwortung"
            }
          ]
        },
        "prognosegrundlage": {
          "description": "Prognosegrundlage\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Prognosegrundlage"
            }
          ]
        },
        "detailsPrognosegrundlage": {
          "type": "array",
          "description": "Prognosegrundlage\nBesteht der Bedarf ein tagesparameteräbhängiges Lastprofil mit gemeinsamer Messung anzugeben, so ist dies über die 2 -malige\nWiederholung des CAV Segments mit der Angabe der Codes E02 und E14 möglich.\n            ",
          "x-nullable": true,
          "items": {
            "$ref": "#/definitions/Profiltyp"
          }
        },
        "wahlrechtPrognosegrundlage": {
          "description": "Wahlrecht der Prognosegrundlage (true = Wahlrecht beim Lieferanten vorhanden)\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/WahlrechtPrognosegrundlage"
            }
          ]
        },
        "fallgruppenzuordnung": {
          "description": "Fallgruppenzuordnung (für gas RLM)\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Fallgruppenzuordnung"
            }
          ]
        },
        "prioritaet": {
          "type": "integer",
          "description": "Priorität des Bilanzkreises (für Gas)\n            ",
          "format": "int32",
          "x-nullable": true
        },
        "grundWahlrechtPrognosegrundlage": {
          "description": "Grund Wahlrecht der Prognosegrundlage (true = Wahlrecht beim Lieferanten vorhanden)\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/WahlrechtPrognosegrundlage"
            }
          ]
        },
        "abwicklungsmodell": {
          "description": "Abwicklungsmodell\n            ",
          "x-nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/Abwicklungsmodell"
            }
          ]
        },
        "positionsnummer": {
          "type": "string",
          "description": "Aus der ORDERS gemappte Positionsnummer der Anfrage",
          "x-nullable": true
        }
      }
    }

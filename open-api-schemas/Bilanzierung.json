              "x-nullable": true,
              "x-example": "1234x"
            },
            "dienstanbieter": {
              "type": "string",
              "description": "Dienstanbieter (bei Temperaturmessstellen)\n            ",
              "x-nullable": true,
              "x-example": "ZT1"
            },
            "herausgeber": {
              "type": "string",
              "description": "Herausgeber des Lastprofil-Codes\n            ",
              "x-nullable": true,
              "x-example": "BDEW"
            }
          }
